#:kivy 2.2.0
# Dark-themed layout for the autonomous desktop assistant GUI.
# ARCHITECTURE.md section 10: HomeScreen, TaskScreen, HistoryScreen, SettingsScreen.

#:import StepRow gui.widgets.step_row.StepRow

<Label>:
    color: 0.92, 0.92, 0.95, 1

<Button>:
    background_normal: ''
    background_color: 0.18, 0.2, 0.26, 1
    color: 0.92, 0.92, 0.95, 1

<TextInput>:
    background_color: 0.12, 0.13, 0.17, 1
    foreground_color: 0.92, 0.92, 0.95, 1
    cursor_color: 0.92, 0.92, 0.95, 1
    padding: 8, 8

<NavBar@BoxLayout>:
    size_hint_y: None
    height: 48
    spacing: 4
    padding: 4, 4
    canvas.before:
        Color:
            rgba: 0.09, 0.1, 0.13, 1
        Rectangle:
            pos: self.pos
            size: self.size
    Button:
        text: "Home"
        on_release: app.root.current = "home"
    Button:
        text: "Task"
        on_release: app.root.current = "task"
    Button:
        text: "History"
        on_release: app.root.current = "history"
    Button:
        text: "Settings"
        on_release: app.root.current = "settings"

<StepRow>:
    orientation: "horizontal"
    size_hint_y: None
    height: 40
    spacing: 8
    padding: 8, 4
    canvas.before:
        Color:
            rgba: 0.13, 0.14, 0.18, 1
        Rectangle:
            pos: self.pos
            size: self.size
    Label:
        text: root.status_icon
        size_hint_x: None
        width: 32
        color: (0.95, 0.75, 0.15, 1) if root.status == "running" else ((0.25, 0.8, 0.4, 1) if root.status == "verified" else ((0.9, 0.3, 0.3, 1) if root.status == "failed" else (0.6, 0.6, 0.6, 1)))
    Label:
        text: root.description
        text_size: self.width, None
        halign: "left"
        valign: "middle"

<ApprovalModal>:
    title: "Approval Required"
    size_hint: 0.6, 0.4
    auto_dismiss: False
    BoxLayout:
        orientation: "vertical"
        padding: 16
        spacing: 12
        canvas.before:
            Color:
                rgba: 0.11, 0.12, 0.15, 1
            Rectangle:
                pos: self.pos
                size: self.size
        Label:
            text: "This step is flagged high-risk and needs your approval:"
            size_hint_y: None
            height: 30
        Label:
            text: root.step_description
            text_size: self.width, None
            halign: "center"
        BoxLayout:
            size_hint_y: None
            height: 48
            spacing: 12
            Button:
                text: "Deny"
                background_color: 0.5, 0.15, 0.15, 1
                on_release: root.deny()
            Button:
                text: "Approve"
                background_color: 0.15, 0.45, 0.2, 1
                on_release: root.approve()

ScreenManager:
    HomeScreen:
        name: "home"
    TaskScreen:
        name: "task"
    HistoryScreen:
        name: "history"
    SettingsScreen:
        name: "settings"

<HomeScreen>:
    canvas.before:
        Color:
            rgba: 0.08, 0.09, 0.11, 1
        Rectangle:
            pos: self.pos
            size: self.size
    BoxLayout:
        orientation: "vertical"
        NavBar:
        BoxLayout:
            orientation: "vertical"
            padding: 24
            spacing: 16
            Label:
                text: "What do you want to get done?"
                font_size: 22
                size_hint_y: None
                height: 40
            TextInput:
                id: objective_input
                hint_text: "e.g. Book a table for 2 at 7pm tonight"
                multiline: False
                size_hint_y: None
                height: 48
                font_size: 16
            Label:
                text: "Quick sources (demo stubs):"
                size_hint_y: None
                height: 24
                color: 0.7, 0.7, 0.75, 1
            GridLayout:
                cols: 4
                size_hint_y: None
                height: 44
                spacing: 8
                Button:
                    text: "Todoist"
                    on_release: root.set_quick_source("todoist")
                Button:
                    text: "Gmail"
                    on_release: root.set_quick_source("gmail")
                Button:
                    text: "Calendar"
                    on_release: root.set_quick_source("calendar")
                Button:
                    text: "Files"
                    on_release: root.set_quick_source("files")
            Widget:
            Button:
                text: "Run"
                size_hint_y: None
                height: 56
                font_size: 18
                background_color: 0.15, 0.45, 0.2, 1
                on_release: root.run_objective()

<TaskScreen>:
    canvas.before:
        Color:
            rgba: 0.08, 0.09, 0.11, 1
        Rectangle:
            pos: self.pos
            size: self.size
    BoxLayout:
        orientation: "vertical"
        NavBar:
        BoxLayout:
            orientation: "vertical"
            padding: 16
            spacing: 12
            Label:
                id: status_label
                text: "No active task."
                size_hint_y: None
                height: 30
                font_size: 16
            BoxLayout:
                orientation: "horizontal"
                spacing: 12
                BoxLayout:
                    orientation: "vertical"
                    size_hint_x: 0.6
                    Label:
                        text: "Plan"
                        size_hint_y: None
                        height: 24
                        color: 0.7, 0.7, 0.75, 1
                    ScrollView:
                        BoxLayout:
                            id: step_list
                            orientation: "vertical"
                            size_hint_y: None
                            height: self.minimum_height
                            spacing: 4
                BoxLayout:
                    orientation: "vertical"
                    size_hint_x: 0.4
                    Label:
                        text: "Screen preview"
                        size_hint_y: None
                        height: 24
                        color: 0.7, 0.7, 0.75, 1
                    Image:
                        id: preview_image
                        allow_stretch: True
            BoxLayout:
                size_hint_y: None
                height: 48
                spacing: 12
                Button:
                    text: "Pause / Resume"
                    on_release: root.toggle_pause()
                Button:
                    text: "Cancel"
                    background_color: 0.5, 0.15, 0.15, 1
                    on_release: root.cancel_task()

<HistoryScreen>:
    canvas.before:
        Color:
            rgba: 0.08, 0.09, 0.11, 1
        Rectangle:
            pos: self.pos
            size: self.size
    BoxLayout:
        orientation: "vertical"
        NavBar:
        BoxLayout:
            orientation: "vertical"
            padding: 16
            spacing: 8
            Label:
                text: "Task History"
                font_size: 20
                size_hint_y: None
                height: 32
            ScrollView:
                BoxLayout:
                    id: history_list
                    orientation: "vertical"
                    size_hint_y: None
                    height: self.minimum_height
                    spacing: 4

<SettingsScreen>:
    canvas.before:
        Color:
            rgba: 0.08, 0.09, 0.11, 1
        Rectangle:
            pos: self.pos
            size: self.size
    BoxLayout:
        orientation: "vertical"
        NavBar:
        BoxLayout:
            orientation: "vertical"
            padding: 16
            spacing: 12
            Label:
                text: "Settings"
                font_size: 20
                size_hint_y: None
                height: 32
            BoxLayout:
                size_hint_y: None
                height: 40
                spacing: 8
                Label:
                    text: "Control backend:"
                    size_hint_x: 0.4
                Spinner:
                    id: backend_spinner
                    text: "Native"
                    values: ["Native", "OpenClaw", "NemoClaw"]
            BoxLayout:
                size_hint_y: None
                height: 40
                spacing: 8
                Label:
                    text: "Planning model:"
                    size_hint_x: 0.4
                TextInput:
                    id: planning_model_input
                    multiline: False
            BoxLayout:
                size_hint_y: None
                height: 40
                spacing: 8
                Label:
                    text: "Verification model:"
                    size_hint_x: 0.4
                TextInput:
                    id: verification_model_input
                    multiline: False
            Label:
                text: "Allow-listed directories:"
                size_hint_y: None
                height: 24
                color: 0.7, 0.7, 0.75, 1
            ScrollView:
                size_hint_y: 0.4
                BoxLayout:
                    id: directory_list
                    orientation: "vertical"
                    size_hint_y: None
                    height: self.minimum_height
                    spacing: 4
            BoxLayout:
                size_hint_y: None
                height: 40
                spacing: 8
                TextInput:
                    id: new_dir_input
                    hint_text: "C:\\path\\to\\allow"
                    multiline: False
                Button:
                    text: "Add"
                    size_hint_x: None
                    width: 80
                    on_release: root.add_directory()
            Widget:
            Label:
                id: settings_status_label
                text: ""
                size_hint_y: None
                height: 24
                color: 0.5, 0.8, 0.9, 1
            Button:
                text: "Save Settings"
                size_hint_y: None
                height: 48
                background_color: 0.15, 0.45, 0.2, 1
                on_release: root.save_settings()
