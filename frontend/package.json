{
  "name": "assistant-frontend",
  "version": "0.1.0",
  "private": true,
  "description": "Orchestratr desktop task orchestration app",
  "productName": "Orchestratr",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "concurrently -k -n VITE,ELECTRON -c blue,green \"vite\" \"npm:electron:dev\"",
    "electron:dev": "tsc -p electron/tsconfig.json && wait-on tcp:5173 && cross-env NODE_ENV=development electron --no-sandbox dist-electron/main.js",
    "build": "tsc -p tsconfig.json --noEmit && vite build && tsc -p electron/tsconfig.json",
    "start": "npm run build && cross-env NODE_ENV=production electron --no-sandbox dist-electron/main.js",
    "package": "npm run build && electron-builder"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.0.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^6.0.4",
    "concurrently": "^8.2.2",
    "cross-env": "^7.0.3",
    "electron": "^39.8.5",
    "electron-builder": "^26.15.3",
    "typescript": "^5.5.4",
    "vite": "^8.1.5",
    "wait-on": "^7.2.0"
  },
  "build": {
    "appId": "com.orchestratr.desktop",
    "files": [
      "dist/**/*",
      "dist-electron/**/*"
    ],
    "directories": {
      "output": "release"
    },
    "mac": {
      "icon": "public/Orchestratr.icns",
      "category": "public.app-category.productivity"
    }
  }
}
